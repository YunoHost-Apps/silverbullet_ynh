# SilverBullet MCP sidecar environment (managed by YunoHost).
# SB_AUTH_TOKEN is a SilverBullet dashboard API token (/.dashboard -> user -> API tokens).
# Set it in the app config panel. Empty = the bridge runs but cannot read the space.
SB_API_BASE_URL="http://127.0.0.1:__PORT__"
SB_AUTH_TOKEN="__SB_API_TOKEN__"
MCP_TOKEN="__MCP_TOKEN__"
PORT=__PORT_MCP__
