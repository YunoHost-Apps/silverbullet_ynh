[Unit]
Description=SilverBullet MCP bridge
After=network.target __APP__.service
Wants=__APP__.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/mcp
EnvironmentFile=__INSTALL_DIR__/mcp.env
Environment="PATH=__PATH_WITH_NODEJS__"
ExecStart=__NODEJS_DIR__/node dist/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Moderate sandboxing (kept compatible with the Node.js runtime)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
