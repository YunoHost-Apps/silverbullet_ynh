#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template="default.env" --destination="$install_dir/default.env"

ynh_config_add --template="custom.env" --destination="$data_dir/custom.env"

chmod 600 "$data_dir/custom.env"
chown "$app:$app" "$data_dir/custom.env"

#=================================================
# INITIALISE THE SPACES
#=================================================
# SilverBullet 2.11+ runs in multi-space mode once the data folder has been
# configured. Without this step the server starts in "unconfigured" mode and
# only exposes the setup wizard on /.setup/, which no one knows about.
# `silverbullet setup` creates the admin account and the first space in one go,
# so the app is usable as soon as the service is up.
ynh_script_progression "Setting up the initial SilverBullet space..."

# The data folder is owned by the app user; run setup as that user so the files
# it creates are not left root-owned.
mkdir -p "$data_dir/notes"
chown "$app:$app" "$data_dir/notes"

# `silverbullet setup` exits 1 when the folder is already configured, and in
# that case it leaves the existing accounts/spaces untouched - which is what we
# want on re-install and on upgrade. So we only need to distinguish "already
# configured" from a real failure.
setup_rc=0
setup_output="$(sudo -u "$app" "$install_dir/silverbullet" setup "$data_dir/notes" \
    --admin "$admin:$admin_pw" --space "Notes" 2>&1)" || setup_rc=$?

chown -R "$app:$app" "$data_dir"

if [ "$setup_rc" -eq 0 ]; then
    ynh_print_info "SilverBullet admin '$admin' created and first space initialised."
elif [ -e "$data_dir/notes/spaces.json" ]; then
    ynh_print_info "SilverBullet was already configured - existing spaces and accounts preserved."
else
    ynh_print_warn "Could not initialise the SilverBullet space: $setup_output"
    ynh_print_warn "The app will start on the setup wizard, reachable at https://$domain$path_url/.setup/ after installation."
fi

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="The hacker's notebook"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
